# Jetson USB camera one-click startup configuration.
# Paths may use ${HOME}; this file is sourced by start_detector.sh.

ROS_DISTRO=foxy
VENV_PATH="${HOME}/venvs/yolo_ros2"

# The active model remains YOLO26s because it currently has the stronger
# validation result. Change this to yolo26m_baseline_v1 to benchmark YOLO26m.
MODEL_ID=yolo26s_baseline_v2

# Use the stable UVC identifier discovered on this Jetson. "auto" falls back
# to any *-video-index0 link and finally /dev/video* when this camera changes.
CAMERA_SOURCE=auto
CAMERA_BY_ID="usb-USB_corp._usb_camera_usb_camera-video-index0"
CAMERA_WAIT_SECONDS=30
CAMERA_BACKEND=auto
CAMERA_FPS=30.0
CAMERA_FRAME_ID=camera_optical_frame
CAMERA_RECONNECT_INTERVAL=2.0
CAMERA_READ_FAILURE_THRESHOLD=3

DEVICE=0
IMGSZ=640
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
PUBLISH_ANNOTATED_IMAGE=true

# Empty uses <project>/outputs/captures. MP4 frames contain detection boxes.
CAPTURE_OUTPUT_DIR=""
RECORD_ON_START=false
RECORDING_FPS=10.0
RECORDING_CODEC=mp4v

# Rebuild only the yolo_detector ROS 2 package before each start. This costs a
# few seconds but ensures a git pull is reflected immediately.
BUILD_ON_START=true

# Start rqt_image_view automatically when it is installed and a graphical
# desktop is available. Keep false for headless/SSH use.
OPEN_VIEWER=false
